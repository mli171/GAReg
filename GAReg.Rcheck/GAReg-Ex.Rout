> base::assign(".ptime", proc.time(), pos = "CheckExEnv")
> ### Name: gareg_knots
> ### Title: Genetic-Algorithm–based Optimal Knot Selection
> ### Aliases: gareg_knots
> 
> ### ** Examples
> 
> ## No test: 
> set.seed(1)
> N <- 120
> y <- c(rnorm(40, 0), rnorm(40, 3), rnorm(40, 0))
> x <- seq_len(N)
> 
> # 1) Varying-knots with single-pop GA
> g1 <- gareg_knots(
+   y, x,
+   minDist = 5,
+   gaMethod = "cptga",
+   cptgactrl = cptgaControl(popSize = 150, pcrossover = 0.9, maxgen = 500)
+ )
> summary(g1)
##########################################################
# Varying Knots Detection via changepointGA              #
##########################################################
   Settings: 
   Population size         = 150
   Number of generations   = 500
   GA convergence          = 1
   Crossover probability   = 0.9
   Mutation probability    = 0.3
   Changepoint probability = 0.01
   Parallel Usage          = FALSE

##### Best ##### 
   Fitness   = 25.99536 
   m         = 3 
   knots     = 32 43 97 
> 
> # 2) Fixed knots (operators auto-injected unless overridden)
> g2 <- gareg_knots(
+   y, x,
+   fixedknots = 5,
+   minDist = 5
+ )
> summary(g2)
##########################################################
# Fixed Knots Detection via changepointGA                #
##########################################################
   Settings: 
   Population size         = 200
   Number of generations   = 11212
   GA convergence          = 0
   Crossover probability   = 0.95
   Mutation probability    = 0.3
   Changepoint probability = 0.01
   Parallel Usage          = FALSE

##### Best ##### 
   Fitness   = 24.89091 
   m         = 5 
   knots     = 40 46 52 76 82 
> 
> # 3) Island GA with island-specific controls
> g3 <- gareg_knots(
+   y, x,
+   gaMethod = "cptgaisl",
+   minDist = 6,
+   cptgactrl = cptgaControl(
+     engine = "cptgaisl",
+     numIslands = 8, maxMig = 250,
+     popSize = 120, pcrossover = 0.9
+   )
+ )
> summary(g3)
##########################################################
